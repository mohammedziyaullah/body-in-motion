"Plateau","Plain","Hilly","Plain","Plateau"),
Fertilizer_Use = c("High","Medium","High","Low","Medium",
"High","Medium","Low","High","Medium"),
Crop = c("Rice","Millets","Sugarcane","Wheat","Groundnut",
"Rice","Maize","Bajra","Cotton","Pulses"),
Yield = c("High","Medium","Very High","Medium","Medium",
"High","Medium","Low","High","Medium"),
stringsAsFactors = FALSE
)
target_col <- "Yield"
# Entropy function
print("24MID0265")
print("Mohamed Ziyaullah S")
entropy <- function(target) {
freq <- table(target) / length(target)
freq <- freq[freq > 0]
-sum(freq * log2(freq))
}
info_gain <- function(data, feature, target = target_col) {
total_entropy <- entropy(data[[target]])
levels_feat <- unique(data[[feature]])
weighted_entropy <- 0
for (lv in levels_feat) {
subset_data <- data[data[[feature]] == lv, ]
weight <- nrow(subset_data) / nrow(data)
weighted_entropy <- weighted_entropy +
weight * entropy(subset_data[[target]])
}
total_entropy - weighted_entropy
}
# Recursive ID3 algorithm
print("24MID0265")
print("Mohamed Ziyaullah S")
id3 <- function(data, features, target = target_col,
node_name = "Root") {
node <- Node$new(node_name)
if (length(unique(data[[target]])) == 1) {
node$name <- paste0(
node_name, "\n[", unique(data[[target]]), "]"
)
node$leaf_class <- unique(data[[target]])
return(node)
}
if (length(features) == 0) {
majority_class <- names(
sort(table(data[[target]]), decreasing = TRUE)
)[1]
node$name <- paste0(
node_name, "\n[", majority_class, "] (majority)"
)
node$leaf_class <- majority_class
return(node)
}
# Select feature with maximum information gain
gains <- sapply(features, function(f) {
info_gain(data, f, target)
})
best_feature <- names(which.max(gains))
node$name <- paste0(
node_name, "\nSplit on: ", best_feature,
" (IG=", round(max(gains), 3), ")"
)
remaining_features <- setdiff(features, best_feature)
# Add branches
for (lv in sort(unique(data[[best_feature]]))) {
subset_data <- data[data[[best_feature]] == lv, ]
child_node <- id3(
subset_data,
remaining_features,
target,
node_name = paste0(best_feature, " = ", lv)
)
node$AddChildNode(child_node)
}
node
}
# Calculate information gain values
features <- setdiff(names(data), target_col)
cat("INFORMATION GAIN VALUES:\n")
for (feature in features) {
gain <- info_gain(data, feature, target_col)
cat(feature, "=", round(gain, 4), "\n")
}
# Build the tree
agri_tree <- id3(
data,
features,
target_col
)
# Print and plot the tree
print(agri_tree)
plot(agri_tree)
