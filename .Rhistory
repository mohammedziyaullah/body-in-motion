# Prediction function for the supplied crop-yield records
predict_yield <- function(crop) {
crop_yield <- c(
Rice = "High",
Millets = "Medium",
Sugarcane = "Very High",
Wheat = "Medium",
Groundnut = "Medium",
Maize = "Medium",
Bajra = "Low",
Cotton = "High",
Pulses = "Medium"
)
if (crop %in% names(crop_yield)) {
return(unname(crop_yield[crop]))
}
return("Unknown crop")
}
# Test predictions
cat("Predicted yield for Rice:",
predict_yield("Rice"), "\n")
cat("Predicted yield for Cotton:",
predict_yield("Cotton"), "\n")
cat("Predicted yield for Sugarcane:",
predict_yield("Sugarcane"), "\n")
